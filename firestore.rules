rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tournaments/{tournamentId} {
      // Public tournament: anyone with the link can view and update the live tournament.
      allow read, write: if true;
    }
    match /tournamentHistory/{historyId} {
      // Archived tournament snapshots are public on the history page.
      allow read, write: if true;
    }
  }
}
